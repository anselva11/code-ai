# AXIOM AI AGENTS Configuration
# Copy this file to .env: cp .env.example .env

# System Settings
AXIOM_ENV=production
AXIOM_LOG_LEVEL=INFO
AXIOM_CACHE_DIR=data/cache
AXIOM_REPORTS_DIR=reports
AXIOM_CACHE_TTL_HOURS=24

# Optional LLM Provider (for qualitative synthesis, disabled by default via --no-llm)
# Supported: openai, anthropic, gemini, local
AXIOM_LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Financial Data API Keys (free tier supported)
# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Finnhub (https://finnhub.io/)
FINNHUB_API_KEY=

# Twelve Data (https://twelvedata.com/)
TWELVE_DATA_API_KEY=
